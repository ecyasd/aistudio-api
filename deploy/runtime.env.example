# Store the real file as /etc/aistudio-console/runtime.env, mode 0600.
AISTUDIO_WEB_PASSWORD=replace-with-a-random-management-password
# Seeded once when /data/config.yaml does not exist; later changes use the UI.
AISTUDIO_BOOTSTRAP_API_KEY=replace-with-a-separate-random-call-key
AISTUDIO_TIMEZONE=Asia/Hong_Kong
# Initial engine when runtime.engine has not been saved through the console.
AISTUDIO_ENGINE=browserless
# Docker enables the authenticated restart button by default.
AISTUDIO_ALLOW_RESTART=1
